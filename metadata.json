{
  "icon": "drk-icon.svg",
  "ui": {
    "dashboard-tab": {
      "title": "Docker Rescue Kit",
      "root": "ui",
      "src": "index.html",
      "backend": {
        "socket": "drk.sock"
      }
    }
  },
  "vm": {
    "composefile": "compose.yaml",
    "exposes": {
      "socket": "drk.sock"
    }
  },
  "host": {
    "binaries": [
      {
        "darwin": [{ "path": "/host/darwin/drk-doctor.sh" }],
        "linux": [{ "path": "/host/linux/drk-doctor.sh" }],
        "windows": [
          { "path": "/host/windows/drk-doctor.ps1" },
          { "path": "/host/windows/generated/drk-catalogue.ps1" }
        ]
      }
    ]
  }
}
